{
    "id": "exif",
    "label": "Exif",
    "icon": "lens",
    "postTypes": [
        "gallery"
    ],
    "settings": [
        {
            "key": "display_exif",
            "type": "toggle",
            "label": "Display EXIF Data",
            "default": false,
            "tier_required": "free",
            "render_when_unlicensed": true,
            "setting_lives_in": "free",
            "visible_when_uninstalled": true
        },
        {
            "key": "exif_fields",
            "type": "token_select",
            "label": "Fields to Display",
            "description": "The fields this gallery shows, in the order they appear. Only fields the image actually carries are rendered.",
            "api_endpoint": "/wp-json/fotogrids/v1/admin/exif-fields",
            "options_key": "fields",
            "sortable": true,
            "keep_open": true,
            "default": [
                "camera",
                "lens",
                "aperture",
                "shutter_speed",
                "iso",
                "focal_length"
            ],
            "fallback_options": [
                {
                    "label": "Camera",
                    "value": "camera",
                    "tier_required": "free"
                },
                {
                    "label": "Lens",
                    "value": "lens",
                    "tier_required": "free"
                },
                {
                    "label": "Aperture",
                    "value": "aperture",
                    "tier_required": "free"
                },
                {
                    "label": "Shutter Speed",
                    "value": "shutter_speed",
                    "tier_required": "free"
                },
                {
                    "label": "ISO",
                    "value": "iso",
                    "tier_required": "free"
                },
                {
                    "label": "Focal Length",
                    "value": "focal_length",
                    "tier_required": "free"
                }
            ],
            "condition": {
                "dependsOn": "display_exif",
                "values": [
                    true,
                    "1"
                ]
            },
            "tier_required": "free",
            "render_when_unlicensed": true,
            "setting_lives_in": "free",
            "visible_when_uninstalled": true
        },
        {
            "key": "exif_per_image_notice",
            "type": "promo",
            "messages": [
                {
                    "subtitle": "Per-image EXIF overrides.",
                    "message": "Override EXIF display settings for individual images. Customize which fields to show or hide on a per-image basis for complete control.",
                    "learn_more": "feature-exif"
                }
            ],
            "tier_required": "pro_starter",
            "render_when_unlicensed": true,
            "setting_lives_in": "free",
            "visible_when_uninstalled": true
        }
    ],
    "tier_required": "free"
}
