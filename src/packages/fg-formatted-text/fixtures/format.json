[
	{"name": "plain text", "input": "Shot from the pier", "html": "Shot from the pier", "text": "Shot from the pier", "normalized": "Shot from the pier", "lossy": false},
	{"name": "empty", "input": "", "html": "", "text": "", "normalized": "", "lossy": false},
	{"name": "whitespace only", "input": "   ", "html": "", "text": ""},
	{"name": "link without policy", "input": "Shot from the <a href=\"https://example.com/pier\">north pier</a>", "html": "Shot from the <a href=\"https://example.com/pier\">north pier</a>", "text": "Shot from the north pier", "normalized": "Shot from the <a href=\"https://example.com/pier\">north pier</a>", "lossy": false},
	{"name": "link with new-tab policy", "input": "Shot from the <a href=\"https://example.com/pier\">north pier</a>", "options": {"policy": {"newTab": true, "rel": []}, "newTabLabel": "(opens in a new tab)"}, "html": "Shot from the <a href=\"https://example.com/pier\" target=\"_blank\" rel=\"noopener\">north pier<span class=\"fg-formatted-text-sr\"> (opens in a new tab)</span></a>"},
	{"name": "link with nofollow policy", "input": "<a href=\"https://example.com\">site</a>", "options": {"policy": {"newTab": false, "rel": ["nofollow"]}}, "html": "<a href=\"https://example.com\" rel=\"nofollow\">site</a>"},
	{"name": "explicit target wins over policy", "input": "<a href=\"https://example.com\" target=\"_self\">site</a>", "options": {"policy": {"newTab": true, "rel": []}, "newTabLabel": "(opens in a new tab)"}, "html": "<a href=\"https://example.com\" target=\"_self\">site</a>"},
	{"name": "explicit empty rel wins over policy", "input": "<a href=\"https://example.com\" rel=\"\">site</a>", "options": {"policy": {"newTab": false, "rel": ["nofollow"]}}, "html": "<a href=\"https://example.com\">site</a>", "normalized": "<a href=\"https://example.com\" rel=\"\">site</a>", "lossy": false},
	{"name": "rel tokens are filtered", "input": "<a href=\"/x\" rel=\"NoFollow ugc noopener\">x</a>", "html": "<a href=\"/x\" rel=\"nofollow ugc\">x</a>", "normalized": "<a href=\"/x\" rel=\"nofollow ugc\">x</a>", "lossy": false},
	{"name": "nesting deeper than the limit is unwrapped", "input": "<b><b><b><b><b><b><b><b><b><b><b><b><b><b><b><b><b><b>x</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>y", "html": "<b><b><b><b><b><b><b><b><b><b><b><b><b><b><b><b>x</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>y", "normalized": "<b><b><b><b><b><b><b><b><b><b><b><b><b><b><b><b>x</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>y", "lossy": true},
	{"name": "unknown rel token is lossy", "input": "<a href=\"/x\" rel=\"nofollow me\">x</a>", "html": "<a href=\"/x\" rel=\"nofollow\">x</a>", "normalized": "<a href=\"/x\" rel=\"nofollow\">x</a>", "lossy": true},
	{"name": "editor-added rel leaves the link to the policy", "input": "<a href=\"https://example.com\" target=\"_blank\" rel=\"noreferrer noopener\">x</a>", "options": {"policy": {"newTab": false, "rel": ["nofollow"]}}, "html": "<a href=\"https://example.com\" target=\"_blank\" rel=\"nofollow noopener\">x</a>", "normalized": "<a href=\"https://example.com\" target=\"_blank\">x</a>", "lossy": false},
	{"name": "empty rel is an explicit follow", "input": "<a href=\"https://example.com\" rel=\"\">x</a>", "options": {"policy": {"newTab": false, "rel": ["nofollow"]}}, "html": "<a href=\"https://example.com\">x</a>", "normalized": "<a href=\"https://example.com\" rel=\"\">x</a>", "lossy": false},
	{"name": "policy rel limited to known tokens", "input": "<a href=\"/x\">x</a>", "options": {"policy": {"newTab": false, "rel": ["nofollow", "evil"]}}, "html": "<a href=\"/x\" rel=\"nofollow\">x</a>"},
	{"name": "invalid target is dropped", "input": "<a href=\"/x\" target=\"evil\">x</a>", "options": {"policy": {"newTab": true, "rel": []}}, "html": "<a href=\"/x\" target=\"_blank\" rel=\"noopener\">x</a>", "normalized": "<a href=\"/x\">x</a>", "lossy": true},
	{"name": "links off", "input": "Go <a href=\"https://example.com\">there</a>", "options": {"links": false}, "html": "Go there"},
